    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.6",
    "js-yaml": "^4.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "postcss": "^8.4.47",
    "qrcode-generator": "^2.0.4",
    "tailwindcss": "^3.4.13",
