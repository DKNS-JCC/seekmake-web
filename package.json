  "description": "3DCC Salamanca — Next.js + Supabase",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "export": "next build",
    "seed": "tsx supabase/seed.ts",
    "seed:productos": "tsx supabase/seed-productos.ts",
    "envio": "tsx scripts/sendcloud.ts",
