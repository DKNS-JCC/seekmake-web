    "marked": "^14.1.4",
    "next": "^16.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-snowfall": "^2.4.0",
    "three": "^0.184.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.7.5",
