# Copy to .env.local and fill in once you create the Supabase project.
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only — used by supabase/seed.ts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX).
# Leave empty to disable ads (e.g. in development).
NEXT_PUBLIC_ADSENSE_CLIENT=
